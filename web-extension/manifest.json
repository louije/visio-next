{
  "manifest_version": 3,
  "name": "VisioNext — adaptive Visio layout",
  "version": "0.3.2",
  "description": "Adaptive participant layout on Visio, plus a global mute for your browser calls with the VisioNext macOS app.",
  "homepage_url": "https://github.com/louije/visio-next",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "visio-meet-layout@meidosem.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "nativeMessaging", "scripting"],
  "host_permissions": ["https://visio.numerique.gouv.fr/*"],
  "optional_host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://teams.live.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["sites.js", "background.js"]
  },
  "action": {
    "default_title": "Adaptive Visio layout",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["https://visio.numerique.gouv.fr/*"],
      "css": ["enhance.css"],
      "js": ["layout-engine.js", "providers/visio.js", "call-bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
